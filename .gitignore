# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/

# ── Python environments (never commit .venv or virtualenvs) ───────────────────
.venv/
venv/
env/
*/.venv/
*/venv/
*/env/
__pycache__/
*.pyc
*.pyo

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
.quasar/

# ── Compiled / generated binaries ─────────────────────────────────────────────
*.exe
*.dll
*.so
*.dylib

# ── Secrets and environment ───────────────────────────────────────────────────
.env
.env.local
.env.*

# ── Large export/scrape files (keep scripts, not raw data dumps) ──────────────
*.csv
ps_export.*
name-of-archive.*

# ── Solidity / Hardhat artifacts ──────────────────────────────────────────────
contracts/artifacts/
contracts/cache/
contracts/typechain-types/
contracts/deployed-*.json

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
*.sqlite
